{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "yarn install",
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/((?!assets/|work/)[^.]+)",
      "destination": "/",
      "permanent": false
    }
  ]
}
